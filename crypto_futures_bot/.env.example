# ============================================================
#  OKX API anahtarları — bu dosyayı .env olarak kopyalayın
#  cp .env.example .env   ve  gerçek değerleri girin.
#  .env dosyası .gitignore'dadır, ASLA commit edilmez.
# ============================================================

# --- OKX API (gerçek hesap) ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# OKX demo (testnet) kullanıyorsanız true yapın.
# true iken isteklere x-simulated-trading: 1 header'ı eklenir.
OKX_DEMO=false

# --- Telegram (opsiyonel, telegram_enabled=True ise gerekir) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
